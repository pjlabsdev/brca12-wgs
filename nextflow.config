// brca12-wgs · BRCA1/BRCA2 germline analysis from WGS (GRCh38)
manifest {
    name            = 'genome-brca12'
    description     = 'BRCA1/BRCA2 Keimbahn-Auswertung aus WGS (GRCh38), nur Forschung (RUO)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.2'
}

params.outdir = 'brca12_results'
params.report_pdf = false   // also print brca12_report.pdf with headless Chrome/Chromium
params.chrome = null        // path to Chrome/Chromium for --report_pdf (searched on PATH otherwise)
params.container = 'brca12-wgs:1.1.0'

process {
    errorStrategy = 'terminate'
}

profiles {
    standard {
        // Tools from PATH or via --bwa/--gatk/...
        process.executor = 'local'
    }
    docker {
        // Image built from the Dockerfile in this repository (docker build -t brca12-wgs:1.1.0 .)
        // or pulled from GitHub Container Registry once published. VEP cache, reference and
        // ClinVar are mounted from the host paths given on the command line.
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = params.container
        params.manta_config = '/opt/conda/envs/manta/bin/configManta.py'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = "docker://${params.container}"
        params.manta_config    = '/opt/conda/envs/manta/bin/configManta.py'
    }
    conda {
        conda.enabled  = true
        process {
            conda = "${projectDir}/envs/brca12.yml"
            withName: 'CALL_SV_MANTA' { conda = "${projectDir}/envs/manta.yml" }
        }
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
